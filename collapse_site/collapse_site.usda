#usda 1.0
(
    customLayerData = {
        dictionary larpverse = {
            double core_extent_m = 105
            double extent_m = 320
            string frame = "x=east y=north z=up, metres"
            string generator = "build_collapse_site.py"
            string origin = "centre of scanned site"
        }
        dictionary renderSettings = {
            bool "rtx:ambientOcclusion:enabled" = 1
            double "rtx:ambientOcclusion:rayLength" = 3
            bool "rtx:fog:enabled" = 1
            float3 "rtx:fog:fogColor" = (0.78, 0.74, 0.68)
            double "rtx:fog:fogColorIntensity" = 1
            double "rtx:fog:fogDistanceDensity" = 0.35
            double "rtx:fog:fogEndDist" = 900
            double "rtx:fog:fogEndHeight" = 60
            double "rtx:fog:fogHeightDensity" = 0.25
            double "rtx:fog:fogStartDist" = 60
            double "rtx:fog:fogStartHeight" = 0
            bool "rtx:fog:fogZup:enabled" = 1
            bool "rtx:indirectDiffuse:enabled" = 1
            float3 "rtx:post:colorcorr:contrast" = (1.12, 1.12, 1.12)
            bool "rtx:post:colorcorr:enabled" = 1
            float3 "rtx:post:colorcorr:gain" = (1, 1, 1)
            float3 "rtx:post:colorcorr:gamma" = (1, 1, 1)
            float3 "rtx:post:colorcorr:offset" = (0, 0, 0)
            float3 "rtx:post:colorcorr:saturation" = (1.08, 1.08, 1.08)
            bool "rtx:post:histogram:enabled" = 0
            bool "rtx:post:lensFlares:enabled" = 1
            double "rtx:post:lensFlares:flareScale" = 0.04
            double "rtx:post:tonemap:cameraShutter" = 50
            double "rtx:post:tonemap:fNumber" = 5
            double "rtx:post:tonemap:filmIso" = 100
            int "rtx:post:tonemap:op" = 6
            bool "rtx:post:tvNoise:enableFilmGrain" = 1
            bool "rtx:post:tvNoise:enableGhostFlickering" = 0
            bool "rtx:post:tvNoise:enableRandomSplotches" = 0
            bool "rtx:post:tvNoise:enableScanlines" = 0
            bool "rtx:post:tvNoise:enableScrollBug" = 0
            bool "rtx:post:tvNoise:enableVerticalLines" = 0
            bool "rtx:post:tvNoise:enableVignetting" = 1
            bool "rtx:post:tvNoise:enableVignettingFlickering" = 0
            bool "rtx:post:tvNoise:enableWaveDistortion" = 0
            bool "rtx:post:tvNoise:enabled" = 1
            double "rtx:post:tvNoise:grainAmount" = 0.025
            double "rtx:post:tvNoise:grainSize" = 1.4
            double "rtx:post:tvNoise:vignettingSize" = 107
            double "rtx:post:tvNoise:vignettingStrength" = 0.55
            bool "rtx:reflections:enabled" = 1
            bool "rtx:shadows:enabled" = 1
        }
    }
    defaultPrim = "CollapseSite"
    doc = "Collapsed-building disaster site for Isaac Sim (Larpverse / AgentVerse 2026). Z-up, metres. Core 105 m reconstructed from top-down + oblique screenshots of a photogrammetry scan; surroundings (320 m x 320 m) procedurally extrapolated."
    metersPerUnit = 1
    subLayers = [
        @./geo/terrain.usdc@,
        @./geo/buildings.usdc@,
        @./geo/debris.usdc@
    ]
    upAxis = "Z"
)

over "CollapseSite" (
    kind = "assembly"
)
{
    def Scope "Looks"
    {
        def Material "terrain_r0c0"
        {
            token outputs:mdl:displacement.connect = </CollapseSite/Looks/terrain_r0c0/OmniPBR.outputs:out>
            token outputs:mdl:surface.connect = </CollapseSite/Looks/terrain_r0c0/OmniPBR.outputs:out>
            token outputs:mdl:volume.connect = </CollapseSite/Looks/terrain_r0c0/OmniPBR.outputs:out>
            token outputs:surface.connect = </CollapseSite/Looks/terrain_r0c0/PreviewSurface.outputs:surface>

            def Shader "OmniPBR"
            {
                uniform token info:implementationSource = "sourceAsset"
                uniform asset info:mdl:sourceAsset = @OmniPBR.mdl@
                uniform token info:mdl:sourceAsset:subIdentifier = "OmniPBR"
                float inputs:bump_factor = 1
                asset inputs:diffuse_texture = @./textures/terrain_r0c0_albedo.jpg@ (
                    colorSpace = "sRGB"
                )
                float inputs:metallic_constant = 0
                asset inputs:normalmap_texture = @./textures/terrain_r0c0_normal.jpg@ (
                    colorSpace = "raw"
                )
                float inputs:reflection_roughness_constant = 0.9
                asset inputs:reflectionroughness_texture = @./textures/terrain_r0c0_rough.jpg@ (
                    colorSpace = "raw"
                )
                float inputs:reflectionroughness_texture_influence = 1
                float inputs:specular_level = 0.35
                token outputs:out
            }

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor.connect = </CollapseSite/Looks/terrain_r0c0/albedoTex.outputs:rgb>
                float inputs:metallic = 0
                normal3f inputs:normal.connect = </CollapseSite/Looks/terrain_r0c0/normalTex.outputs:rgb>
                float inputs:roughness = 0.9
                float inputs:roughness.connect = </CollapseSite/Looks/terrain_r0c0/roughTex.outputs:r>
                token outputs:surface
            }

            def Shader "stReader"
            {
                uniform token info:id = "UsdPrimvarReader_float2"
                string inputs:varname = "st"
                float2 outputs:result
            }

            def Shader "albedoTex"
            {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @./textures/terrain_r0c0_albedo.jpg@
                token inputs:sourceColorSpace = "sRGB"
                float2 inputs:st.connect = </CollapseSite/Looks/terrain_r0c0/stReader.outputs:result>
                token inputs:wrapS = "clamp"
                token inputs:wrapT = "clamp"
                float3 outputs:rgb
            }

            def Shader "normalTex"
            {
                uniform token info:id = "UsdUVTexture"
                float4 inputs:bias = (-1, -1, -1, 0)
                asset inputs:file = @./textures/terrain_r0c0_normal.jpg@
                float4 inputs:scale = (2, 2, 2, 1)
                token inputs:sourceColorSpace = "raw"
                float2 inputs:st.connect = </CollapseSite/Looks/terrain_r0c0/stReader.outputs:result>
                token inputs:wrapS = "clamp"
                token inputs:wrapT = "clamp"
                float3 outputs:rgb
            }

            def Shader "roughTex"
            {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @./textures/terrain_r0c0_rough.jpg@
                token inputs:sourceColorSpace = "raw"
                float2 inputs:st.connect = </CollapseSite/Looks/terrain_r0c0/stReader.outputs:result>
                token inputs:wrapS = "clamp"
                token inputs:wrapT = "clamp"
                float outputs:r
            }
        }

        def Material "terrain_r0c1"
